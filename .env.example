# === DATABASE ===
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/nyaya_marga
DATABASE_ECHO=false

# === CACHE & CELERY ===
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# === STORAGE ===
UPLOAD_BASE_PATH=/tmp/nyaya_uploads
MAX_UPLOAD_SIZE_MB=50

# === NLP (Phase 2) ===
NLP_MODEL_NAME=law-ai/InLegalBERT
NLP_CHUNK_SIZE=400
NLP_CHUNK_OVERLAP=50
NLP_CONFIDENCE_THRESHOLD=0.75

# === LLM & RAG (Phase 3) ===
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
LLM_TEMPERATURE=0.3
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2

# === Gemini Flash API (Primary LLM) ===
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
USE_GEMINI_FALLBACK=true

# === API ===
API_TITLE=Nyaya Marga - Intelligent Ingestion Engine
API_VERSION=0.1.0
DEBUG=false
